import cv2
import numpy as np
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision
import urllib.request
import os

# 1. Download MediaPipe models if missing
hand_model_path = 'hand_landmarker.task'
if not os.path.exists(hand_model_path):
    print("Downloading hand landmarker model...")
    url = "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task"
    urllib.request.urlretrieve(url, hand_model_path)

face_model_path = 'face_landmarker.task'
if not os.path.exists(face_model_path):
    print("Downloading face landmarker model...")
    url = "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task"
    urllib.request.urlretrieve(url, face_model_path)

# 2. Configure Hand & Face Landmarkers (Synchronous IMAGE mode)
hand_base_options = python.BaseOptions(model_asset_path=hand_model_path)
hand_options = vision.HandLandmarkerOptions(
    base_options=hand_base_options,
    running_mode=vision.RunningMode.IMAGE,
    num_hands=2,
    min_hand_detection_confidence=0.5,
    min_hand_presence_confidence=0.5
)
hand_detector = vision.HandLandmarker.create_from_options(hand_options)

face_base_options = python.BaseOptions(model_asset_path=face_model_path)
face_options = vision.FaceLandmarkerOptions(
    base_options=face_base_options,
    running_mode=vision.RunningMode.IMAGE,
    num_faces=2,
    min_face_detection_confidence=0.5,
    min_face_presence_confidence=0.5
)
face_detector = vision.FaceLandmarker.create_from_options(face_options)

# Fingertip landmark indices (MediaPipe 21-point model)
FINGER_TIPS = {
    "Thumb": 4,
    "Index": 8,
    "Middle": 12,
    "Ring": 16,
    "Pinky": 20
}

# Hand skeleton line connections
HAND_CONNECTIONS = [
    (0, 1), (1, 2), (2, 3), (3, 4),       # Thumb
    (0, 5), (5, 6), (6, 7), (7, 8),       # Index
    (0, 9), (9, 10), (10, 11), (11, 12),  # Middle
    (0, 13), (13, 14), (14, 15), (15, 16),# Ring
    (0, 17), (17, 18), (18, 19), (19, 20),# Pinky
    (5, 9), (9, 13), (13, 17)             # Palm
]

# 3. Initialize External USB Webcam (Index 1 with Fallback to Index 0)
WEBCAM_INDEX = 1
backend = cv2.CAP_DSHOW if os.name == 'nt' else cv2.CAP_ANY

cap = cv2.VideoCapture(WEBCAM_INDEX, backend)

if not cap.isOpened():
    print(f"External webcam at index {WEBCAM_INDEX} not found. Falling back to index 0...")
    cap = cv2.VideoCapture(0, backend)

cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

if not cap.isOpened():
    print("Error: Could not access any camera feed.")
    exit()

# Warm up camera buffer
for _ in range(10):
    cap.read()

print("Camera feed established. Starting tracking loop...")

while cap.isOpened():
    success, frame = cap.read()
    if not success or frame is None or frame.size == 0:
        continue

    # Mirror the frame horizontally for standard display orientation
    frame = cv2.flip(frame, 1)
    h, w, _ = frame.shape

    # Synchronous frame conversion and detection
    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame)

    face_result = face_detector.detect(mp_image)
    hand_result = hand_detector.detect(mp_image)

    # ------------------ 1. FACE DETECTION (Astronaut Label) ------------------
    if face_result and face_result.face_landmarks:
        for face_lms in face_result.face_landmarks:
            pts = [(int(lm.x * w), int(lm.y * h)) for lm in face_lms]

            x_coords = [p[0] for p in pts]
            y_coords = [p[1] for p in pts]
            
            pad = 20
            x1, y1 = max(0, min(x_coords) - pad), max(0, min(y_coords) - pad)
            x2, y2 = min(w, max(x_coords) + pad), min(h, max(y_coords) + pad)

            # Draw bounding box around detected face
            cv2.rectangle(frame, (x1, y1), (x2, y2), (255, 0, 255), 2)
            
            # Draw label
            cv2.putText(
                frame, 
                "Astronaut", 
                (x1, y1 - 10), 
                cv2.FONT_HERSHEY_SIMPLEX, 
                0.7, 
                (255, 0, 255), 
                2
            )

    # ------------------ 2. HAND TRACKING (Corrected Handedness) ------------------
    if hand_result and hand_result.hand_landmarks:
        for i, hand_lms in enumerate(hand_result.hand_landmarks):
            hand_label = "Hand"
            if hand_result.handedness and i < len(hand_result.handedness):
                detected_side = hand_result.handedness[i][0].category_name
                
                # Invert handedness because the feed is horizontally mirrored
                mirrored_side = "Left" if detected_side == "Right" else "Right"
                hand_label = f"{mirrored_side} Hand"

            pts = [(int(lm.x * w), int(lm.y * h)) for lm in hand_lms]

            # Draw skeleton connections
            for start_idx, end_idx in HAND_CONNECTIONS:
                cv2.line(frame, pts[start_idx], pts[end_idx], (0, 255, 0), 2)

            # Draw and label fingertips
            for finger_name, tip_idx in FINGER_TIPS.items():
                tip_pt = pts[tip_idx]
                cv2.circle(frame, tip_pt, 6, (0, 0, 255), -1)
                cv2.putText(
                    frame, 
                    finger_name, 
                    (tip_pt[0] + 5, tip_pt[1] - 5),
                    cv2.FONT_HERSHEY_SIMPLEX, 
                    0.4, 
                    (255, 255, 255), 
                    1
                )

            # Draw hand bounding box and corrected side label
            x_coords = [p[0] for p in pts]
            y_coords = [p[1] for p in pts]
            pad = 15
            x1, y1 = max(0, min(x_coords) - pad), max(0, min(y_coords) - pad)
            x2, y2 = min(w, max(x_coords) + pad), min(h, max(y_coords) + pad)

            cv2.rectangle(frame, (x1, y1), (x2, y2), (255, 255, 0), 2)
            cv2.putText(
                frame, 
                hand_label, 
                (x1, y1 - 8), 
                cv2.FONT_HERSHEY_SIMPLEX, 
                0.6, 
                (255, 255, 0), 
                2
            )

    cv2.imshow("Astronaut & Hand Tracking Feed", frame)

    # Press 'q' to quit
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
